{
  "name": "twitchterino",
  "productName": "Twitchterino",
  "version": "0.1.2",
  "description": "Chat e pontos do canal da Twitch para o PokeIdle: mostra o saldo de cada canal com o preço real dos bônus.",
  "author": "VinniiSaantos",
  "license": "MIT",
  "homepage": "https://viinnisantoos.github.io/twitchterino/",
  "repository": "github:ViinniSantoos/twitchterino",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win",
    "dist:linux": "electron-builder --linux"
  },
  "dependencies": {
    "electron-updater": "^6.6.2"
  },
  "devDependencies": {
    "electron": "45.2.1",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "com.vinniisaantos.twitchterino",
    "productName": "Twitchterino",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "ViinniSantoos",
        "repo": "twitchterino"
      }
    ],
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*",
      "build/icon.png"
    ],
    "electronFuses": {
      "enableCookieEncryption": true,
      "runAsNode": false,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "onlyLoadAppFromAsar": true
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "artifactName": "Twitchterino-Setup.exe",
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Twitchterino",
      "runAfterFinish": true
    },
    "portable": {
      "artifactName": "Twitchterino-portatil.exe"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "build/icon.png",
      "category": "Network",
      "executableName": "twitchterino",
      "synopsis": "Chat e pontos da Twitch para o PokeIdle",
      "maintainer": "VinniiSaantos <122901997+ViinniSantoos@users.noreply.github.com>",
      "syncDesktopName": true
    },
    "appImage": {
      "artifactName": "Twitchterino-linux.AppImage"
    },
    "deb": {
      "artifactName": "Twitchterino-linux.deb"
    }
  },
  "desktopName": "twitchterino.desktop"
}
